// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Silo Core Zones: the immediate supply and demand zones, drawn the Core Strategy way.
// Research only, not financial advice. A chart indicator: it places no orders.
//
// Rules, from the Core Strategy manual (slide numbers in brackets):
//   Candles [79-81]  leg candle = closes outside the range of the preceding candle and looks bullish/bearish
//                    (closes in the top/bottom 40% of its range, candle sentiment [50]); a gap counts as
//                    part of the candle. Everything else is a base candle (neutral, closes inside).
//   Zone [89-91]     leg-in, base (1+ base candles), leg-out. Leg-out up = demand, down = supply.
//   Explosive [72-77] the move out is a leg candle or series of leg candles with consecutive higher (lower)
//                    closes that makes a NEW HIGH (LOW): it must take out the last swing high (low) before the
//                    base. A strong candle that fails to make a new high is not a zone.
//   Lines [96-115]   base isolation: last leg-in candle to first leg-out candle. Proximal at the highest
//                    (demand) / lowest (supply) candle BODY in the base (the preferred setting). Distal at the
//                    lowest (highest) price of the whole DBR / RBD, or of the base and move out for RBR / DBD.
//   Zoning [140-145] start at current price, look down (up) and left until you find the explosive move:
//                    only the IMMEDIATE demand below and supply above price are drawn.
//   Refining [312]   the Refining Time Frame (RTF) is used to refine the proximal and distal lines. The manual
//                    lists it as optional and leaves the method to the XLT, so this is our reading: on the RTF,
//                    find the turning point inside the zone (lowest low for demand, highest high for supply),
//                    take the RTF base right before the first RTF leg out of it, and move the proximal line to
//                    that base's body. The distal line is the same price on any time frame.
//   Odds enhancers [116-136] strength 2 (move out >= 2x the zone, and/or crosses past the previous opposing
//                    zone), time 1 (1-3 base candles; 4-6 = 0.5), freshness 2 (untested; tested up to 50% = 1;
//                    deeper = 0; crossing the distal line disqualifies), trend 2 (ITF), curve 1 (HTF),
//                    profit zone 2 (5:1 = 2, 3:1 = 1).
//   Time frames [316] monthly income: curve 1M, trend 1W, zones 1D. Stop buffer [425]: 10% of daily ATR.
// Use it on a DAILY chart.

//@version=6
indicator("Silo Core Zones (research only)", shorttitle = "Core Zones", overlay = true,
     max_boxes_count = 50, max_lines_count = 50, max_labels_count = 50, max_bars_back = 1000)

// ---------------------------------------------------------------- inputs
grpZ = "Zones"
legClose  = input.float(0.6, "Leg candle closes in the top/bottom share of its range", minval = 0.5, maxval = 0.9, step = 0.05, group = grpZ,
     tooltip = "Candle sentiment slide: closing in the top 40% (60-100%) of the range is bullish, bottom 40% bearish, 40-60% neutral. A leg candle must also close outside the previous candle's range.")
maxBase   = input.int(6, "Max base candles", minval = 1, maxval = 12, group = grpZ,
     tooltip = "Time odds enhancer: 1-3 base candles = 1, 4-6 = 0.5, more = 0.")
minStr    = input.int(1, "Only use zones with strength at least", minval = 0, maxval = 2, group = grpZ,
     tooltip = "The zoning process looks for a VERY strong explosive move. 1 = the move out went at least 2x the zone height or broke past the previous opposing zone.")
violWick  = input.bool(true, "Any trade beyond the distal line violates the zone", group = grpZ,
     tooltip = "On: a wick through the distal line disqualifies the zone (the stop would be hit). Off: only a close beyond it does.")
lookback  = input.int(1000, "Search the last N bars", minval = 100, maxval = 5000, group = grpZ)
extendBars = input.int(25, "Extend zones right by N bars", minval = 0, maxval = 200, group = grpZ)

grpR = "Refining time frame"
doRefine = input.bool(true, "Refine the proximal line on a lower time frame", group = grpR)
rtf      = input.timeframe("60", "Refining time frame", group = grpR,
     tooltip = "Must be lower than the chart. 60 minutes on a daily chart. The zone keeps its daily lines when there is no lower time frame data that far back.")
showRaw  = input.bool(true, "Also outline the unrefined daily zone", group = grpR)

grpT = "Higher time frames"
trendTf = input.timeframe("W", "Trend time frame (ITF)", group = grpT)
curveTf = input.timeframe("M", "Curve time frame (HTF)", group = grpT)
showHtf = input.bool(true, "If no daily supply/demand is left, show the nearest HTF zone instead", group = grpT)

grpP = "Trade plan"
showPlan  = input.bool(false, "Show stop, entry and targets at the immediate demand", group = grpP)
minRR     = input.float(4.0, "Minimum reward:risk (1:x)", minval = 1, maxval = 20, step = 0.5, group = grpP)
halfRR    = input.float(2.0, "Sell half at (1:x)", minval = 0.5, maxval = 10, step = 0.5, group = grpP)
stopAtr   = input.float(0.10, "Stop buffer beyond distal (x daily ATR)", minval = 0, maxval = 1, step = 0.01, group = grpP)
targetPct = input.float(0.75, "Target: share of the profit zone", minval = 0.25, maxval = 1, step = 0.05, group = grpP)

grpC = "Colours"
colDem = input.color(#26a69a, "Demand", group = grpC)
colSup = input.color(#ef5350, "Supply", group = grpC)

// ---------------------------------------------------------------- zone type
type Zone
    bool   demand
    string fm           // DBR, RBR, RBD, DBD
    float  prox         // proximal line in use (refined when possible)
    float  proxRaw      // proximal line from the chart time frame
    float  dist         // distal line
    int    legInBar
    int    baseStart
    int    legOutBar
    int    nBase
    float  extreme      // furthest point of the move out
    float  needed       // the move out must pass this to be explosive (last swing high / low)
    float  oppLevel     // distal line of the previous opposing zone, for the breakout test
    bool   moving  = true
    bool   valid   = false
    bool   refined = false
    float  pen     = 0.0   // deepest earlier test, share of the zone height
    float  visit   = 0.0   // depth of the current test (does not count until it is over)
    bool   inZone  = false

method height(Zone z) =>
    math.abs(z.prox - z.dist)

method strength(Zone z) =>
    float h = z.height()
    float mv = h > 0 ? math.abs(z.extreme - z.prox) / h : 0.0
    bool bo = not na(z.oppLevel) and (z.demand ? z.extreme > z.oppLevel : z.extreme < z.oppLevel)
    (mv >= 2.0 ? 1.0 : 0.0) + (bo ? 1.0 : 0.0)

method timeScore(Zone z) =>
    z.nBase <= 3 ? 1.0 : z.nBase <= 6 ? 0.5 : 0.0

method fresh(Zone z) =>
    z.pen <= 0 ? 2.0 : z.pen <= 0.5 ? 1.0 : 0.0

// ---------------------------------------------------------------- candles
// +1 rally leg, -1 drop leg, 0 base. o/h/l/c of this candle, pc/ph/pl of the previous one.
f_kindOf(float o, float h, float l, float c, float pc, float ph, float pl, float lc) =>
    float hi = na(pc) ? h : math.max(h, pc)   // a gap is coloured in from the previous close
    float lo = na(pc) ? l : math.min(l, pc)
    float rng = hi - lo
    int k = 0
    if rng > 0 and not na(ph)
        float pos = (c - lo) / rng
        if c > ph and pos >= lc
            k := 1
        else if c < pl and pos <= 1 - lc
            k := -1
    k

// ---------------------------------------------------------------- refining on the RTF
// Buffer of lower-time-frame candles: rO/rH/rL/rC, with the chart bar each belongs to in rB.
// Returns the refined proximal line, or na if it cannot be refined.
f_refine(bool demand, int fromBar, float prox, float dist, array<float> rO, array<float> rH, array<float> rL,
     array<float> rC, array<int> rB, float lc) =>
    float res = na
    int n = rB.size()
    int first = -1
    if n > 0
        for i = 0 to n - 1
            if rB.get(i) >= fromBar
                first := i
                break
    if first >= 0 and n - first >= 3
        // the turning point
        int ext = first
        for i = first to n - 1
            if demand ? rL.get(i) < rL.get(ext) : rH.get(i) > rH.get(ext)
                ext := i
        // first RTF leg out of it
        int want = demand ? 1 : -1
        int j = -1
        for i = ext to n - 1
            float pc = i > 0 ? rC.get(i - 1) : na
            float ph = i > 0 ? rH.get(i - 1) : na
            float pl = i > 0 ? rL.get(i - 1) : na
            if f_kindOf(rO.get(i), rH.get(i), rL.get(i), rC.get(i), pc, ph, pl, lc) == want
                j := i
                break
        if j >= 0
            float pce = ext > 0 ? rC.get(ext - 1) : na
            float phe = ext > 0 ? rH.get(ext - 1) : na
            float ple = ext > 0 ? rL.get(ext - 1) : na
            int kExt = f_kindOf(rO.get(ext), rH.get(ext), rL.get(ext), rC.get(ext), pce, phe, ple, lc)
            float p = na
            if j == ext
                p := rO.get(ext)  // the leg out starts at the turning candle: its open
            else
                int s = kExt == -want ? ext + 1 : ext  // the leg-in candle is not part of the base
                if s <= j - 1
                    p := demand ? -1e300 : 1e300
                    for i = s to j - 1
                        p := demand ? math.max(p, math.max(rO.get(i), rC.get(i))) : math.min(p, math.min(rO.get(i), rC.get(i)))
                else
                    p := demand ? math.max(rC.get(ext), rO.get(j)) : math.min(rC.get(ext), rO.get(j))
            if not na(p) and (demand ? p < prox and p > dist : p > prox and p < dist)
                res := p
    res

// ---------------------------------------------------------------- zone finder
f_detect(int mb, int keep, float lc, bool wick, bool refine, array<float> rO, array<float> rH, array<float> rL,
     array<float> rC, array<int> rB) =>
    var array<Zone>  zs  = array.new<Zone>()
    var array<int>   phI = array.new<int>()
    var array<float> phP = array.new<float>()
    var array<int>   plI = array.new<int>()
    var array<float> plP = array.new<float>()
    int k = f_kindOf(open, high, low, close, close[1], high[1], low[1], lc)
    float pvH = ta.pivothigh(high, 2, 2)
    float pvL = ta.pivotlow(low, 2, 2)
    if not na(pvH)
        phI.push(bar_index - 2)
        phP.push(pvH)
        if phI.size() > 200
            phI.shift()
            phP.shift()
    if not na(pvL)
        plI.push(bar_index - 2)
        plP.push(pvL)
        if plI.size() > 200
            plI.shift()
            plP.shift()

    // 1. a formation completes on this bar? (built before the updates, so the opposing zone it breaks is still listed)
    Zone newZ = na
    if k != 0 and nz(k[1], 9) == 0
        int nb = 0
        while nb <= mb and bar_index - 1 - nb >= 0 and nz(k[1 + nb], 9) == 0
            nb += 1
        int li = 1 + nb
        if nb >= 1 and nb <= mb and bar_index - li >= 0 and nz(k[li], 0) != 0
            int legIn = k[li]
            bool up = k > 0
            bool reversal = legIn != k
            // proximal: highest (lowest) body in the base
            float prox = up ? -1e300 : 1e300
            float baseHi = -1e300
            float baseLo = 1e300
            for j = 1 to nb
                prox := up ? math.max(prox, math.max(open[j], close[j])) : math.min(prox, math.min(open[j], close[j]))
                baseHi := math.max(baseHi, high[j])
                baseLo := math.min(baseLo, low[j])
            // distal: extreme of the whole DBR/RBD, or of base + move out for RBR/DBD
            int far = reversal ? li : nb
            float dist = up ? low : high
            for j = 0 to far
                dist := up ? math.min(dist, low[j]) : math.max(dist, high[j])
            // the new high (low) the move out must make: the last swing high (low) before the base
            int baseStartBar = bar_index - nb
            float need = up ? math.max(baseHi, high[li]) : math.min(baseLo, low[li])
            if up and phI.size() > 0
                for q = phI.size() - 1 to 0
                    if phI.get(q) < baseStartBar and phP.get(q) > need
                        need := phP.get(q)
                        break
            if not up and plI.size() > 0
                for q = plI.size() - 1 to 0
                    if plI.get(q) < baseStartBar and plP.get(q) < need
                        need := plP.get(q)
                        break
            // the previous opposing zone the move out may break past
            float opp = na
            float oppProx = na
            for o in zs
                if o.valid and o.demand != up
                    if up and o.prox > prox and (na(oppProx) or o.prox < oppProx)
                        oppProx := o.prox
                        opp := o.dist
                    if not up and o.prox < prox and (na(oppProx) or o.prox > oppProx)
                        oppProx := o.prox
                        opp := o.dist
            if (up ? prox > dist : prox < dist)
                float ext = up ? high : low
                string fm = up ? (reversal ? "DBR" : "RBR") : (reversal ? "RBD" : "DBD")
                float proxUse = prox
                bool isRef = false
                if refine
                    float r = f_refine(up, reversal ? bar_index - li : baseStartBar, prox, dist, rO, rH, rL, rC, rB, lc)
                    if not na(r)
                        proxUse := r
                        isRef := true
                newZ := Zone.new(up, fm, proxUse, prox, dist, bar_index - li, baseStartBar, bar_index, nb, ext, need, opp,
                     true, up ? ext > need : ext < need, isRef, 0.0, 0.0, false)

    // 2. update earlier zones: move out, tests, violation
    if zs.size() > 0
        for i = zs.size() - 1 to 0
            Zone z = zs.get(i)
            bool drop = false
            if z.moving
                float dir = z.demand ? 1.0 : -1.0
                if (close - close[1]) * dir > 0
                    if z.demand
                        z.extreme := math.max(z.extreme, high)
                        if z.fm == "RBR"
                            z.dist := math.min(z.dist, low)
                        z.valid := z.extreme > z.needed
                    else
                        z.extreme := math.min(z.extreme, low)
                        if z.fm == "DBD"
                            z.dist := math.max(z.dist, high)
                        z.valid := z.extreme < z.needed
                    if (z.demand ? (wick ? low : close) < z.dist : (wick ? high : close) > z.dist)
                        drop := true  // traded through the distal line during the move out
                else
                    z.moving := false
                    drop := not z.valid
            if not z.moving and not drop
                if z.demand
                    if (wick ? low : close) < z.dist
                        drop := true
                    else if low <= z.prox
                        z.visit := math.max(z.visit, (z.prox - low) / z.height())
                        z.inZone := true
                    else
                        if z.inZone
                            z.pen := math.max(z.pen, z.visit)
                        z.visit := 0.0
                        z.inZone := false
                else
                    if (wick ? high : close) > z.dist
                        drop := true
                    else if high >= z.prox
                        z.visit := math.max(z.visit, (high - z.prox) / z.height())
                        z.inZone := true
                    else
                        if z.inZone
                            z.pen := math.max(z.pen, z.visit)
                        z.visit := 0.0
                        z.inZone := false
            if z.baseStart < bar_index - keep
                drop := true
            if drop
                zs.remove(i)
    if not na(newZ)
        zs.push(newZ)
        if zs.size() > 400
            zs.shift()
    zs

// ---------------------------------------------------------------- trend (ITF)
// Uptrend starts when price closes above the last swing high after a higher low; each new break makes the
// latest swing low the controlling low; a close below the controlling low ends it. Downtrend mirrors this.
f_trend() =>
    var int   state  = 0
    var float ctrl   = na
    var float lastHi = na
    var float prevHi = na
    var float lastLo = na
    var float prevLo = na
    float ph = ta.pivothigh(high, 2, 2)
    float pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        prevHi := lastHi
        lastHi := ph
    if not na(pl)
        prevLo := lastLo
        lastLo := pl
    if not na(lastHi) and not na(lastLo)
        if state == 1 and close < ctrl
            state := 0
            ctrl := na
        else if state == -1 and close > ctrl
            state := 0
            ctrl := na
        if close > lastHi
            if state == 1
                ctrl := lastLo
            else if not na(prevLo) and lastLo >= prevLo
                state := 1
                ctrl := lastLo
        else if close < lastLo
            if state == -1
                ctrl := lastHi
            else if not na(prevHi) and lastHi <= prevHi
                state := -1
                ctrl := lastHi
    [state[1], ctrl[1]]  // completed bars only

// ---------------------------------------------------------------- curve (HTF)
// Nearest HTF demand below and supply above (strength >= 1), distal to distal. Falls back to the 10-year range.
// Also returns the immediate HTF supply and demand lines, for when no daily zone is left.
f_curve(int mb, float lc, bool wick) =>
    array<Zone> zs = f_detect(mb, 120, lc, wick, false, array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), array.new<int>())
    float lo = na
    float hi = na
    float sP = na
    float sD = na
    float dP = na
    float dD = na
    bool below = false
    bool above = false
    for z in zs
        if z.valid
            if z.demand
                if z.strength() >= 1
                    below := true
                    lo := na(lo) ? z.dist : math.max(lo, z.dist)
                if na(dP) or z.prox > dP
                    dP := z.prox
                    dD := z.dist
            else
                if z.strength() >= 1
                    above := true
                    hi := na(hi) ? z.dist : math.min(hi, z.dist)
                if na(sP) or z.prox < sP
                    sP := z.prox
                    sD := z.dist
    float mn = low
    float mx = high
    int n = math.min(bar_index, 119)
    for j = 0 to n
        mn := math.min(mn, low[j])
        mx := math.max(mx, high[j])
    bool enough = bar_index >= 23
    if na(lo) or not enough
        lo := mn
    if na(hi) or not enough
        hi := mx
    bool known = below and above and enough
    [lo[1], hi[1], known[1], sP[1], sD[1], dP[1], dD[1]]  // completed bars only

// ---------------------------------------------------------------- scoring
f_matrix(bool demand, float loc, int tdir) =>
    int third = loc < 1.0 / 3 ? 0 : loc <= 2.0 / 3 ? 1 : 2
    int d = 0
    if demand
        d := third == 0 ? (tdir < 0 ? 2 : 1) : third == 1 ? (tdir < 0 ? 0 : 1) : (tdir > 0 ? 2 : 0)
    else
        d := third == 2 ? (tdir > 0 ? 2 : 1) : third == 1 ? (tdir > 0 ? 0 : 1) : (tdir < 0 ? 2 : 0)
    d  // 0 no action, 1 trade, 2 trade only with 5:1

f_score(Zone z, float oppProx, float buf, int tDir, float cLo, float cHi) =>
    bool d = z.demand
    float st = z.strength()
    float tm = z.timeScore()
    float fr = z.fresh()
    float trS = d ? (tDir > 0 ? 2.0 : tDir == 0 ? 1.0 : 0.0) : (tDir < 0 ? 2.0 : tDir == 0 ? 1.0 : 0.0)
    float loc = not na(cLo) and not na(cHi) and cHi > cLo ? (z.prox - cLo) / (cHi - cLo) : 0.5
    float cvS = d ? (loc < 1.0 / 3 ? 1.0 : loc <= 2.0 / 3 ? 0.5 : 0.0) : (loc > 2.0 / 3 ? 1.0 : loc >= 1.0 / 3 ? 0.5 : 0.0)
    float stop = d ? z.dist - buf : z.dist + buf
    float risk = math.abs(z.prox - stop)
    float rr = na(oppProx) ? 99.0 : risk > 0 ? math.abs(oppProx - z.prox) / risk : 0.0
    float pzS = rr >= 5 ? 2.0 : rr >= 3 ? 1.0 : 0.0
    [st + tm + fr + trS + cvS + pzS, st, tm, fr, trS, cvS, pzS, stop, rr, f_matrix(d, loc, tDir)]

f_num(float v) =>
    str.tostring(v, "#.#")

f_px(float v) =>
    str.tostring(v, format.mintick)

f_parts(float st, float tm, float fr, float trS, float cvS, float pzS) =>
    "S" + f_num(st) + " T" + f_num(tm) + " F" + f_num(fr) + " Tr" + f_num(trS) + " C" + f_num(cvS) + " P" + f_num(pzS)

// ---------------------------------------------------------------- run
bool canRefine = doRefine and timeframe.in_seconds(rtf) < timeframe.in_seconds(timeframe.period)
string rtfReq = canRefine ? rtf : timeframe.period
[io, ih, il, ic] = request.security_lower_tf(syminfo.tickerid, rtfReq, [open, high, low, close])

var array<float> rO = array.new<float>()
var array<float> rH = array.new<float>()
var array<float> rL = array.new<float>()
var array<float> rC = array.new<float>()
var array<int>   rB = array.new<int>()
if canRefine
    int m = math.min(io.size(), math.min(ih.size(), math.min(il.size(), ic.size())))
    if m > 0
        for i = 0 to m - 1
            rO.push(io.get(i))
            rH.push(ih.get(i))
            rL.push(il.get(i))
            rC.push(ic.get(i))
            rB.push(bar_index)
    while rB.size() > 0 and rB.first() < bar_index - (maxBase + 3)
        rO.shift()
        rH.shift()
        rL.shift()
        rC.shift()
        rB.shift()

array<Zone> zones = f_detect(maxBase, lookback, legClose, violWick, canRefine, rO, rH, rL, rC, rB)
float atrD = ta.sma(ta.tr(true), 14)
[tDirRaw, tCtrl] = request.security(syminfo.tickerid, trendTf, f_trend(), lookahead = barmerge.lookahead_on)
[cLo, cHi, cKnown, hSP, hSD, hDP, hDD] = request.security(syminfo.tickerid, curveTf, f_curve(maxBase, legClose, violWick), lookahead = barmerge.lookahead_on)
int tDir = nz(tDirRaw, 0)

var array<box>   boxes  = array.new<box>()
var array<line>  lines  = array.new<line>()
var array<label> labels = array.new<label>()
var table info = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 85), border_width = 1)

f_drawZone(Zone z, string txt, color col, array<box> bx) =>
    bx.push(box.new(z.baseStart, math.max(z.prox, z.dist), bar_index + extendBars, math.min(z.prox, z.dist),
         border_color = col, bgcolor = color.new(col, 75), text = txt, text_size = size.small,
         text_color = color.new(col, 0), text_halign = text.align_right, text_valign = text.align_center))
    if showRaw and z.refined
        bx.push(box.new(z.baseStart, math.max(z.proxRaw, z.dist), bar_index + extendBars, math.min(z.proxRaw, z.dist),
             border_color = color.new(col, 30), border_style = line.style_dashed, bgcolor = color.new(col, 100)))

if barstate.islast
    for b in boxes
        b.delete()
    boxes.clear()
    for l in lines
        l.delete()
    lines.clear()
    for lb in labels
        lb.delete()
    labels.clear()

    // the immediate zones: nearest live, explosive zone below (demand) and above (supply) price
    Zone dz = na
    Zone sz = na
    for z in zones
        if z.valid and z.strength() >= minStr
            if z.demand and (na(dz) or z.prox > dz.prox)
                dz := z
            if not z.demand and (na(sz) or z.prox < sz.prox)
                sz := z

    float buf = stopAtr * atrD
    string dTxt = "none"
    string sTxt = "none"
    if not na(dz)
        float oppD = not na(sz) ? sz.prox : (not na(hSP) and hSP > dz.prox ? hSP : na)
        [sc, st, tm, fr, trS, cvS, pzS, stop, rr, dec] = f_score(dz, oppD, buf, tDir, cLo, cHi)
        string howD = dz.refined ? "refined on " + rtf : "not refined"
        dTxt := dz.fm + " " + f_num(sc) + "/10, " + howD
        f_drawZone(dz, "Demand " + dz.fm + "  " + f_num(sc) + "/10" + (dz.inZone ? "  price in zone" : "") +
             "\n" + f_parts(st, tm, fr, trS, cvS, pzS) + "  (" + howD + ")", colDem, boxes)
        if showPlan
            float risk = dz.prox - stop
            float tgt = na(oppD) ? dz.prox + minRR * risk : dz.prox + targetPct * (oppD - dz.prox)
            float rrT = risk > 0 ? (tgt - dz.prox) / risk : 0.0
            int x1 = math.max(dz.baseStart, bar_index - 30)
            int x2 = bar_index + extendBars + 15
            if risk > 0 and rrT >= minRR and dec != 0 and (dec != 2 or rr >= 5)
                float half = dz.prox + halfRR * risk
                lines.push(line.new(x1, dz.prox, x2, dz.prox, color = color.blue, width = 2))
                lines.push(line.new(x1, stop, x2, stop, color = color.red, width = 2))
                lines.push(line.new(x1, half, x2, half, color = color.orange, width = 2, style = line.style_dashed))
                lines.push(line.new(x1, tgt, x2, tgt, color = color.green, width = 2))
                labels.push(label.new(x2, dz.prox, "Entry " + f_px(dz.prox), style = label.style_label_left, color = color.blue, textcolor = color.white, size = size.small))
                labels.push(label.new(x2, stop, "Stop " + f_px(stop), style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small))
                labels.push(label.new(x2, half, "Sell half 1:" + f_num(halfRR) + ", then trail", style = label.style_label_left, color = color.orange, textcolor = color.black, size = size.small))
                labels.push(label.new(x2, tgt, "Target 1:" + f_num(rrT), style = label.style_label_left, color = color.green, textcolor = color.black, size = size.small))
            else
                labels.push(label.new(x2, dz.prox, "No trade: needs 1:" + f_num(minRR) + " before the next supply and a yes from the decision matrix",
                     style = label.style_label_left, color = color.gray, textcolor = color.white, size = size.small))
        if low <= dz.prox
            alert(syminfo.ticker + ": price is in the immediate demand zone (" + f_num(sc) + "/10). Research only.", alert.freq_once_per_bar_close)
    else if showHtf and not na(hDP) and hDP < close
        dTxt := "none on the chart TF; " + curveTf + " demand shown"
        boxes.push(box.new(bar_index - 60, math.max(hDP, hDD), bar_index + extendBars, math.min(hDP, hDD), border_color = colDem,
             border_style = line.style_dashed, bgcolor = color.new(colDem, 90), text = "No daily demand left: nearest " + curveTf + " demand",
             text_size = size.small, text_color = colDem, text_halign = text.align_right))
    if not na(sz)
        float oppS = not na(dz) ? dz.prox : (not na(hDP) and hDP < sz.prox ? hDP : na)
        [sc2, st2, tm2, fr2, trS2, cvS2, pzS2, stop2, rr2, dec2] = f_score(sz, oppS, buf, tDir, cLo, cHi)
        string howS = sz.refined ? "refined on " + rtf : "not refined"
        sTxt := sz.fm + " " + f_num(sc2) + "/10, " + howS
        f_drawZone(sz, "Supply " + sz.fm + "  " + f_num(sc2) + "/10" + (sz.inZone ? "  price in zone" : "") +
             "\n" + f_parts(st2, tm2, fr2, trS2, cvS2, pzS2) + "  (" + howS + ")", colSup, boxes)
        if high >= sz.prox
            alert(syminfo.ticker + ": price is in the immediate supply zone (" + f_num(sc2) + "/10). Research only.", alert.freq_once_per_bar_close)
    else if showHtf and not na(hSP) and hSP > close
        sTxt := "none on the chart TF; " + curveTf + " supply shown"
        boxes.push(box.new(bar_index - 60, math.max(hSP, hSD), bar_index + extendBars, math.min(hSP, hSD), border_color = colSup,
             border_style = line.style_dashed, bgcolor = color.new(colSup, 90), text = "No daily supply left: nearest " + curveTf + " supply",
             text_size = size.small, text_color = colSup, text_halign = text.align_right))

    string tLbl = tDir > 0 ? "up" : tDir < 0 ? "down" : "sideways"
    float cLoc = not na(cLo) and not na(cHi) and cHi > cLo ? (close - cLo) / (cHi - cLo) : na
    string cLbl = na(cLoc) ? "n/a" : (cLoc < 1.0 / 3 ? "low" : cLoc <= 2.0 / 3 ? "middle" : "high") + " (" + str.tostring(math.round(cLoc * 100)) + "%)" + (cKnown ? "" : ", estimated")
    table.cell(info, 0, 0, "Silo Core Zones", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, "research only", text_color = color.silver, text_size = size.small)
    table.cell(info, 0, 1, "Trend (" + trendTf + ")", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, tLbl + (na(tCtrl) ? "" : ", controlling " + f_px(tCtrl)), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Curve (" + curveTf + ")", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, cLbl, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 3, "Immediate supply", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, sTxt, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 4, "Immediate demand", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 4, dTxt, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 5, "Refining TF", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 5, canRefine ? rtf : "off (must be below the chart TF)", text_color = color.white, text_size = size.small)
